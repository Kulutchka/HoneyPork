# ---- Dashboard / auth ----
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_TLS=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SECRET_KEY=please-change-this-to-a-long-random-string

# ---- Data ----
DATA_DIR=data
DB_FILENAME=honeypork.db

# ---- Honeypots ----
HONEYPOT_HOST=0.0.0.0
FTP_ENABLED=true
SSH_ENABLED=true
TELNET_ENABLED=true
HTTP_ENABLED=true
HTTPS_ENABLED=true
MYSQL_ENABLED=true
MSSQL_ENABLED=true
RDP_ENABLED=true

FTP_PORT=21
SSH_PORT=22
TELNET_PORT=23
HTTP_PORT=80
HTTPS_PORT=443
MYSQL_PORT=3306
MSSQL_PORT=1433
RDP_PORT=3389

# ---- IDS ----
IDS_ENABLED=false
IDS_INTERFACE=
SCAN_WINDOW_SECONDS=30
SCAN_PORT_THRESHOLD=8
SYN_FLOOD_THRESHOLD=100

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_CONNECTION=true
TELEGRAM_NOTIFY_CREDENTIAL=true
TELEGRAM_NOTIFY_SCAN=true
TELEGRAM_COOLDOWN_SECONDS=60
